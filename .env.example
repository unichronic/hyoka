POSTGRES_PASSWORD=replace-with-a-long-random-password
HYOKA_BOOTSTRAP_API_KEY=replace-with-a-long-random-bootstrap-key
HYOKA_MANIFEST_SECRET=replace-with-at-least-32-random-characters
HYOKA_PROJECT_ID=default
HYOKA_CORS_ALLOW_ORIGINS=http://localhost:3000

# Local artifact volume is acceptable for single-node evaluation.
# Set these for production object storage.
HYOKA_ARTIFACT_BACKEND=local
HYOKA_ARTIFACT_S3_BUCKET=
HYOKA_ARTIFACT_S3_PREFIX=hyoka/artifacts
HYOKA_ARTIFACT_S3_REGION=
HYOKA_ARTIFACT_S3_ENDPOINT_URL=

# HTTP replay/evaluator callbacks are disabled by default to avoid SSRF.
HYOKA_ENABLE_HTTP_REPLAY=false
HYOKA_HTTP_REPLAY_ALLOWED_HOSTS=

# Optional OpenAI-compatible proxy upstream key.
HYOKA_PROVIDER_API_KEY=
